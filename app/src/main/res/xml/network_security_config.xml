<?xml version="1.0" encoding="utf-8"?>
<!-- Solo HTTPS y las autoridades de certificación del sistema (validación TLS normal de Android). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
